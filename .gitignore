# WordPress core, vendor plugins, media, and secrets are intentionally NOT
# tracked here. This repo only version-controls the custom theme code and
# the handful of root files we actively manage (ads.txt, .htaccess).
# If a full site backup/export is ever extracted into this repo, these
# patterns keep the sensitive/huge parts out of git.

public_html/wp-config.php
public_html/wp-config-sample.php
public_html/wp-admin/
public_html/wp-includes/
public_html/wp-content/uploads/
public_html/wp-content/languages/
public_html/wp-content/upgrade/
public_html/wp-content/upgrade-temp-backup/
public_html/wp-content/plugins/
public_html/wp-content/themes/twenty*/
public_html/wp-*.php
public_html/index.php
public_html/license.txt
public_html/readme.html
public_html/xmlrpc.php
public_html/.ftp-deploy-sync-state.json
public_html/**/.sass-cache/

.DS_Store
Thumbs.db
